{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antiapc",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-06",
  "assets": {
    "directory": "public"
  },
  "dev": {
    // "host": "localhost",
    "port": 9876, 
    // "local_protocol": "http",
  },
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true, // still use workers.dev for dev
  "env": {
    "production": {
      "name": "antiapc",
      "route": "https://www.antiapc.xyz/*",
    }
  },
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "antiapc",
      "database_id": "51e5da16-efe0-4e65-9a2d-6b92879329c8",
      "migrations_dir": "migrations",
    }
  ],
    "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}