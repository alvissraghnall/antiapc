{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antiapc",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-06",
  "assets": {
    "directory": "public"
  },
  "dev": {
    // "host": "localhost",
    "port": 9876, 
    // "local_protocol": "http",
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
